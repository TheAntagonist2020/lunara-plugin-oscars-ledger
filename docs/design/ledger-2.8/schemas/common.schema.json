{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunarafilm.com/wp-json/lunara-ledger/v1/schema/common",
  "title": "Lunara Ledger v1: shared definitions",
  "$defs": {
    "imdbTitleId": {
      "type": "string",
      "pattern": "^tt[0-9]{7,8}$",
      "description": "IMDb title ID."
    },
    "imdbPersonId": {
      "type": "string",
      "pattern": "^nm[0-9]{7,8}$",
      "description": "IMDb name ID."
    },
    "imdbCompanyId": {
      "type": "string",
      "pattern": "^co[0-9]{7,8}$",
      "description": "IMDb company ID."
    },
    "imdbCreditId": {
      "type": "string",
      "pattern": "^(nm|co)[0-9]{7,8}$",
      "description": "IMDb name or company ID."
    },
    "imdbAnyId": {
      "type": "string",
      "pattern": "^(tt|nm|co)[0-9]{7,8}$"
    },
    "entityKind": {
      "enum": [
        "title",
        "person",
        "company"
      ]
    },
    "nominationId": {
      "type": "integer",
      "minimum": 1,
      "description": "1-based data-row ordinal in data/oscars.csv (CSV line number minus 1). Never reused for a different nomination within API v1."
    },
    "ceremonyNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999
    },
    "yearLabel": {
      "type": "string",
      "pattern": "^[0-9]{4}(/[0-9]{2})?$",
      "description": "The Academy's award-year label, verbatim: the film eligibility year ('1927/28' for ceremonies 1-6). Not the ceremony date and not a release year."
    },
    "classCode": {
      "enum": [
        "Acting",
        "Directing",
        "Writing",
        "Title",
        "Production",
        "Music",
        "SciTech",
        "Special"
      ]
    },
    "categorySlug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 100
    },
    "token": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$",
      "description": "Cache token: changes whenever the loaded dataset, its derived tables or the API serializer change."
    },
    "uri": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "categoryRef": {
      "type": "object",
      "description": "A category as it applies to one ceremony.",
      "additionalProperties": false,
      "required": [
        "id",
        "slug",
        "canonical",
        "as_given",
        "label",
        "label_modern",
        "class"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "slug": {
          "$ref": "#/$defs/categorySlug"
        },
        "canonical": {
          "type": "string",
          "description": "One of the 66 canonical category names, e.g. 'ART DIRECTION'."
        },
        "as_given": {
          "type": "string",
          "description": "The category's name at that ceremony, verbatim, e.g. 'PRODUCTION DESIGN'."
        },
        "label": {
          "type": "string",
          "description": "Display label dated to that ceremony (format_category_display(canonical, ceremony))."
        },
        "label_modern": {
          "type": "string",
          "description": "Today's display label for cross-era grouping (format_category_display(canonical, 0))."
        },
        "class": {
          "$ref": "#/$defs/classCode"
        }
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nominations",
        "wins",
        "official_nominations",
        "first_ceremony",
        "last_ceremony"
      ],
      "properties": {
        "nominations": {
          "$ref": "#/$defs/count"
        },
        "wins": {
          "$ref": "#/$defs/count"
        },
        "official_nominations": {
          "$ref": "#/$defs/count"
        },
        "first_ceremony": {
          "$ref": "#/$defs/ceremonyNumber"
        },
        "last_ceremony": {
          "$ref": "#/$defs/ceremonyNumber"
        },
        "categories": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api",
        "token",
        "dataset_version"
      ],
      "properties": {
        "api": {
          "const": "lunara-ledger/v1"
        },
        "token": {
          "$ref": "#/$defs/token"
        },
        "dataset_version": {
          "type": "string",
          "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}-[0-9]+$"
        },
        "total": {
          "$ref": "#/$defs/count"
        },
        "returned": {
          "$ref": "#/$defs/count"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "offset": {
          "$ref": "#/$defs/count"
        },
        "sort": {
          "type": "string"
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9_-]{8,200}$"
        },
        "dimension": {
          "enum": [
            "title",
            "person",
            "company",
            "category",
            "ceremony",
            "class",
            "decade"
          ]
        },
        "query": {
          "type": "object",
          "description": "The canonicalised query parameters this response answers.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "embed": {
          "type": "array",
          "items": {
            "enum": [
              "titles",
              "credits",
              "corrections",
              "links",
              "entities",
              "nominations",
              "latest",
              "reviews",
              "media"
            ]
          },
          "uniqueItems": true
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "self"
      ],
      "properties": {
        "self": {
          "$ref": "#/$defs/uri"
        },
        "next": {
          "oneOf": [
            {
              "$ref": "#/$defs/uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "prev": {
          "oneOf": [
            {
              "$ref": "#/$defs/uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "schema": {
          "$ref": "#/$defs/uri"
        },
        "html": {
          "$ref": "#/$defs/uri"
        }
      }
    },
    "entitySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "imdb_id",
        "kind",
        "name"
      ],
      "properties": {
        "imdb_id": {
          "$ref": "#/$defs/imdbAnyId"
        },
        "kind": {
          "$ref": "#/$defs/entityKind"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Canonical name or title (never a pseudonym or a mis-paired credit)."
        },
        "url": {
          "$ref": "#/$defs/uri"
        },
        "stats": {
          "$ref": "#/$defs/stats"
        }
      }
    },
    "reviewRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "title"
      ],
      "description": "embed=reviews: the newest published Lunara review whose IMDb title meta equals this title.",
      "properties": {
        "url": {
          "$ref": "#/$defs/uri"
        },
        "title": {
          "type": "string"
        }
      }
    },
    "imageRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "width",
        "height",
        "alt"
      ],
      "description": "embed=media: a local media-library image only (review featured image, then the plugin poster library). Never a third-party API URL.",
      "properties": {
        "url": {
          "$ref": "#/$defs/uri"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "alt": {
          "type": "string"
        }
      }
    }
  }
}
